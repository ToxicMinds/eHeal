{
  "$defs": {
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "speaker": {
          "enum": [
            "practitioner",
            "patient"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "start_seconds": {
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "end_seconds": {
          "minimum": 0,
          "title": "End Seconds",
          "type": "number"
        },
        "machine_text": {
          "title": "Machine Text",
          "type": "string"
        },
        "reviewed_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed Text"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "review_status": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "under_review",
            "reviewed",
            "superseded"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "overlap": {
          "default": false,
          "title": "Overlap",
          "type": "boolean"
        }
      },
      "required": [
        "segment_id",
        "speaker",
        "start_seconds",
        "end_seconds",
        "machine_text"
      ],
      "title": "Segment",
      "type": "object"
    },
    "TranscriptionModel": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "faster-whisper",
          "default": "faster-whisper",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "device": {
          "title": "Device",
          "type": "string"
        },
        "compute_type": {
          "title": "Compute Type",
          "type": "string"
        }
      },
      "required": [
        "model",
        "device",
        "compute_type"
      ],
      "title": "TranscriptionModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "appointment_id": {
      "format": "uuid",
      "title": "Appointment Id",
      "type": "string"
    },
    "source_languages": {
      "items": {
        "type": "string"
      },
      "title": "Source Languages",
      "type": "array"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "transcription_model": {
      "$ref": "#/$defs/TranscriptionModel"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "appointment_id",
    "source_languages",
    "created_at_utc",
    "transcription_model",
    "segments"
  ],
  "title": "Transcript",
  "type": "object"
}
